{
  "name": "photography-gallery",
  "version": "4.0.1",
  "description": "Static photography gallery, built with Eleventy",
  "private": true,
  "scripts": {
    "dev": "eleventy --serve --port=3003",
    "build": "eleventy",
    "test": "node --test",
    "rename": "node scripts/rename-local.js",
    "rename-photo": "node scripts/rename-photo.js",
    "sync:r2": "node scripts/sync-r2.js",
    "publish:local": "node scripts/publish-local.js",
    "gen:favicon": "node build/gen-favicon.js",
    "gen:og": "node -e \"const {generateOgImage}=require('./build/og-image');const p=require('./dist/data/photos-1.json');generateOgImage(p,'./dist').then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1)});\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1111.0",
    "@napi-rs/canvas": "0.1.97",
    "exifr": "7.1.3",
    "gray-matter": "4.0.3",
    "sharp": "0.33.5"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.5"
  }
}
