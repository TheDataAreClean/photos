{
  "name": "photography-gallery",
  "version": "1.0.0",
  "description": "Static photography gallery — Glass.photo + local photos, built with Eleventy",
  "private": true,
  "scripts": {
    "dev": "eleventy --serve --port=3003",
    "build": "eleventy",
    "build:fresh": "FRESH=1 eleventy",
    "rename": "node scripts/rename.js",
    "rename:glass": "node scripts/rename-glass.js",
    "rename:local": "node scripts/rename-local.js",
    "sync:glass": "node scripts/sync-glass.js",
    "sync:r2": "node scripts/sync-r2.js",
    "publish:ghost": "node scripts/publish-ghost.js",
    "gen:favicon": "node build/gen-favicon.js",
    "gen:og": "node -e \"const {generateOgImage}=require('./build/og-image');const p=require('./dist/data/photos-1.json');generateOgImage(p,'./dist').then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1)});\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1111.0",
    "@napi-rs/canvas": "0.1.97",
    "@tryghost/admin-api": "1.14.11",
    "exifr": "7.1.3",
    "gray-matter": "4.0.3",
    "marked": "18.0.9",
    "sharp": "0.33.5"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.5"
  }
}
