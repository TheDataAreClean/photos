<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <key>Label</key>
  <string>com.thedataareclean.photos-local-sync</string>

  <!-- Run scripts/local-sync.sh from the project root -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/thedataareclean/Documents/thedataareclean/photos/scripts/local-sync.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/thedataareclean/Documents/thedataareclean/photos</string>

  <!-- launchd does not inherit your interactive shell's `export`s — without
       these, publish-local.js runs but silently skips the R2 backup step
       ("R2: not configured"). Fill in your REAL values on the INSTALLED copy
       at ~/Library/LaunchAgents/ only — never commit real credentials here,
       this checked-in file must keep placeholders. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>R2_BUCKET</key>
    <string>REPLACE_ME</string>
    <key>R2_ENDPOINT_URL</key>
    <string>REPLACE_ME</string>
    <key>R2_ACCESS_KEY_ID</key>
    <string>REPLACE_ME</string>
    <key>R2_SECRET_ACCESS_KEY</key>
    <string>REPLACE_ME</string>
  </dict>

  <!-- Every 20 minutes -->
  <key>StartInterval</key>
  <integer>1200</integer>

  <!-- Also run once as soon as the agent is loaded, not just after the first interval -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Logs — viewable with: tail -f ~/Library/Logs/photos-local-sync.log -->
  <key>StandardOutPath</key>
  <string>/Users/thedataareclean/Library/Logs/photos-local-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/thedataareclean/Library/Logs/photos-local-sync.log</string>

</dict>
</plist>
