# Dependencies
node_modules/

# Build cache (re-created on build)
.cache/

# Environment — never commit secrets
.env
.env.*

# Build output
# Remove dist/ from this file if deploying via GitHub Pages without CI.
# Keep it ignored if using Netlify / Vercel / any CI that runs the build.
dist/

# Local source photos — originals carry raw EXIF/GPS, never commit them.
# Sidecar captions are plain text with no location data, so those are
# tracked normally (same treatment as glass-sidecars/).
local/*
!local/.gitkeep
!local/*.md

# Obsidian workspace state (local editor config, not project content)
.obsidian/

# OS
.DS_Store
Thumbs.db
