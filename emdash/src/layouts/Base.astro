---
// Same <head> and shell as the Eleventy site's _includes/layouts/base.njk.
import { getSiteSettingsWithCacheHint } from "emdash";
import { createPublicPageContext } from "emdash/page";
import { EmDashBodyEnd, EmDashBodyStart } from "emdash/ui";
import { site } from "../lib/gallery";

interface Props {
	pageTitle?: string | null;
	ogImage?: string | null;
	ogDescription?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
}

const { pageTitle, ogImage, ogDescription, content } = Astro.props;
const settingsResult = await getSiteSettingsWithCacheHint();
if (Astro.cache?.enabled) Astro.cache.set(settingsResult.cacheHint);
const siteUrl = (settingsResult.data?.url || Astro.url.origin).replace(/\/$/, "");
const pageUrl = Astro.url.pathname;
const absUrl = (url: string) => (/^https?:\/\//.test(url) ? url : siteUrl + url);

const title = pageTitle ? `${pageTitle} — ${site.title}` : site.title;
const description = ogDescription || site.description;
const image = ogImage || "/og-image.jpg";

// Only for EmDash's editing toolbar and inline editing (shown to signed-in editors).
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: ogImage ? "article" : "website",
	title,
	pageTitle: pageTitle || site.title,
	description,
	canonical: siteUrl + pageUrl,
	content,
	siteName: site.title,
});
---

<!doctype html>
<html lang="en" style="background-color:#111">
<head>
  <meta charset="UTF-8">
  <style is:inline>html,body{background:#111}</style>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#111111">
  <meta name="color-scheme" content="dark">
  <title>{title}</title>

  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex">
  <meta name="description" content={description}>
  <meta name="author" content="Arpit (@thedataareclean)">
  <link rel="canonical" href={siteUrl + pageUrl}>
  <link rel="alternate" type="application/atom+xml" title={site.displayTitle} href={`${siteUrl}/feed.xml`}>

  <meta property="og:site_name" content={site.title}>
  <meta property="og:title"     content={pageTitle || site.title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content={ogImage ? "article" : "website"}>
  <meta property="og:url" content={siteUrl + pageUrl}>
  <meta property="og:image" content={absUrl(image)}>
  <meta property="og:image:width"  content="1200">
  <meta property="og:image:height" content="630">

  <meta name="twitter:card"    content="summary_large_image">
  <meta name="twitter:site"    content="@thedataareclean">
  <meta name="twitter:creator" content="@thedataareclean">
  <meta name="twitter:title"   content={pageTitle || site.title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={absUrl(image)}>

  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=VT323&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500&family=Schoolbell&display=swap" onload="this.onload=null;this.rel='stylesheet'">
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,400,0..1,0&icon_names=casino,dashboard_2,info,photo_prints" onload="this.onload=null;this.rel='stylesheet'">
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=VT323&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500&family=Schoolbell&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,400,0..1,0&icon_names=casino,dashboard_2,info,photo_prints">
  </noscript>

  <link rel="stylesheet" href="/styles/base.css">
  <link rel="stylesheet" href="/styles/desk.css">
  <link rel="stylesheet" href="/styles/grid.css">
  <link rel="stylesheet" href="/styles/photo-card.css">
  <link rel="stylesheet" href="/styles/view-toggle.css">

  <link rel="preload" as="style" href="/styles/lightbox.css"   onload="this.onload=null;this.rel='stylesheet'">
  <link rel="preload" as="style" href="/styles/photo-page.css" onload="this.onload=null;this.rel='stylesheet'">
  <link rel="preload" as="style" href="/styles/stack.css"      onload="this.onload=null;this.rel='stylesheet'">
  <link rel="preload" as="style" href="/styles/series.css"     onload="this.onload=null;this.rel='stylesheet'">
  <noscript>
    <link rel="stylesheet" href="/styles/lightbox.css">
    <link rel="stylesheet" href="/styles/photo-page.css">
    <link rel="stylesheet" href="/styles/stack.css">
    <link rel="stylesheet" href="/styles/series.css">
  </noscript>
</head>
<body>
<EmDashBodyStart page={pageCtx} />

<slot />

<EmDashBodyEnd page={pageCtx} />
</body>
</html>
