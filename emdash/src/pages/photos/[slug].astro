---
// Same markup as the Eleventy site's src/photos/photo.njk.
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { loadGallery, longDate, toGalleryPhoto, type PhotoData } from "../../lib/gallery";

const slug = Astro.params.slug ?? "";
const { entry, cacheHint } = await getEmDashEntry<PhotoData>("photos", slug);
if (!entry) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { photos, series } = await loadGallery();
// The entry itself, so an editor sees their draft; series membership from the gallery.
const listed = photos.find((p) => p.id === entry.id);
const photo = { ...toGalleryPhoto(entry.id, entry.data), series: listed?.series ?? null };
const seriesMeta = photo.series ? series[photo.series] : undefined;

// Edit annotations only exist for a signed-in editor in edit mode.
const editing = Object.keys({ ...entry.edit.title }).length > 0;

const exif = photo.exif;
let focal = exif.focalLength35;
if (focal && exif.focalLength) focal = `${focal} (${exif.focalLength})`;
else if (!focal) focal = exif.focalLength || "—";
---

<Base
  pageTitle={photo.title || photo.altText || ""}
  ogImage={photo.url.display}
  ogDescription={photo.description || ""}
  content={{ collection: "photos", id: entry.data.id, slug: entry.id }}
>
<a href="/" class="lightbox__close photo-page__close" aria-label="Back to gallery">&times;</a>

<div class="lightbox__backdrop photo-page__backdrop"></div>
<main class="lightbox__layout photo-page">

  <div class="lightbox__photo-col">
    <div class="lightbox__print">
      <img
        src={photo.url.display}
        alt={photo.altText || photo.title || ""}
        draggable="false"
        decoding="async"
        fetchpriority="high"
      />
      <div class="img-protect"></div>
    </div>
  </div>

  <div class="lightbox__meta-col">

    <button class="lightbox__meta-toggle" aria-label="Close photo info" aria-expanded="true">
      <span class="material-symbols-outlined" aria-hidden="true">info</span>
    </button>

    <div class="lightbox__tabs">
      <button class="lightbox__tab-btn is-active" data-tab="about">About</button>
      <button class="lightbox__tab-btn" data-tab="info">Info</button>
    </div>

    <div class="lightbox__meta-panels">
    <div class="lightbox__meta-top">
      {(photo.title || editing) && <div class="lightbox__title" {...entry.edit.title}>{photo.title}</div>}
      {editing ? (
        <div class="lightbox__description lightbox__description--editing"><PortableText value={entry.data.caption ?? []} /></div>
      ) : (
        photo.description && <p class="lightbox__description">{photo.description}</p>
      )}
      {seriesMeta && <a class="lightbox__series-tag" href={`/series/${photo.series}/`}>{seriesMeta.title}</a>}
    </div>

    <div class="lightbox__meta-bottom">
      <div class="lightbox__exif">
        <dl class="exif-grid">
          <dt>Camera</dt>  <dd>{exif.camera       || "—"}</dd>
          <dt>Lens</dt>    <dd>{exif.lens         || "—"}</dd>
          <dt>Focal</dt>   <dd>{focal}</dd>
          <dt>Aperture</dt><dd>{exif.aperture     || "—"}</dd>
          <dt>Shutter</dt> <dd>{exif.shutterSpeed || "—"}</dd>
          <dt>ISO</dt>     <dd>{exif.iso          || "—"}</dd>
        </dl>
      </div>

      <div class="lightbox__footer">
        {photo.dateTaken && <span>{longDate(photo.dateTaken)}</span>}
      </div>

      <div class="lightbox__actions">
        <button class="lightbox__action-btn" id="pp-share">
          <span>Share</span><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        </button>
        {(photo.url.download || photo.url.display) && (
        <a class="lightbox__action-btn" href={photo.url.download || photo.url.display} download={photo.id}>Download<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg></a>
        )}
        {Astro.locals.user && <a class="lightbox__action-btn" href={`/_emdash/admin/content/photos/${entry.data.id}`}>Edit</a>}
      </div>
    </div>
    </div>

    <div class="lightbox__nav">
      <a href="/" class="photo-page__back">&#8592; Gallery</a>
    </div>

  </div>

</main>

{editing && <style is:inline>.lightbox__description--editing p { margin: 0 0 1em; }</style>}
<script is:inline>
(function () {
  // Meta panel toggle
  var layoutEl = document.querySelector('.photo-page');
  var metaToggleBtn = document.querySelector('.photo-page .lightbox__meta-toggle');
  var ppMetaOpen = true;
  function setMetaOpen(open) {
    ppMetaOpen = open;
    if (layoutEl) layoutEl.classList.toggle('is-meta-open', open);
    if (metaToggleBtn) {
      metaToggleBtn.setAttribute('aria-expanded', String(open));
      metaToggleBtn.setAttribute('aria-label', open ? 'Close photo info' : 'Open photo info');
    }
  }
  setMetaOpen(true);
  if (metaToggleBtn) {
    metaToggleBtn.addEventListener('click', function () { setMetaOpen(!ppMetaOpen); });
  }

  // Share button — copies page URL
  var shareBtn = document.getElementById('pp-share');
  if (shareBtn) {
    var label = shareBtn.querySelector('span');
    shareBtn.addEventListener('click', function () {
      navigator.clipboard.writeText(window.location.href).then(function () {
        label.textContent = 'Copied!';
        setTimeout(function () { label.textContent = 'Share'; }, 1500);
      });
    });
  }

  // Block right-click on photo
  var photoImg = document.querySelector('.lightbox__print img');
  if (photoImg) photoImg.addEventListener('contextmenu', function (e) { e.preventDefault(); });

  // Mobile tab switching — set initial state (info visible, exif hidden)
  var tabs = document.querySelectorAll('.photo-page .lightbox__tab-btn');
  var top  = document.querySelector('.photo-page .lightbox__meta-top');
  var bot  = document.querySelector('.photo-page .lightbox__meta-bottom');
  if (bot) bot.classList.add('is-hidden');
  tabs.forEach(function (btn) {
    btn.addEventListener('click', function () {
      tabs.forEach(function (b) { b.classList.remove('is-active'); });
      btn.classList.add('is-active');
      var isInfo = btn.dataset.tab === 'info';
      if (top) top.classList.toggle('is-hidden', isInfo);
      if (bot) bot.classList.toggle('is-hidden', !isInfo);
    });
  });
})();
</script>
</Base>
