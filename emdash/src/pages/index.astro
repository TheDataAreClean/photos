---
import { getEmDashCollection, getEmDashEntry } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { formatDate, tilt } from "../lib/photos";

const [photosResult, seriesResult] = await Promise.all([
	getEmDashCollection("photos", { orderBy: { date_taken: "desc" }, limit: 500 }),
	getEmDashCollection("series", { orderBy: { published_at: "desc" } }),
]);
if (photosResult.error || seriesResult.error) {
	return new Response("Could not load the gallery", { status: 500 });
}
if (Astro.cache?.enabled) {
	Astro.cache.set(photosResult.cacheHint);
	Astro.cache.set(seriesResult.cacheHint);
}

// Collection queries don't hydrate reference fields, so load each series on its own.
const seriesList = (
	await Promise.all(
		seriesResult.entries.map((s) =>
			getEmDashEntry("series", s.id, { references: { cover: true, photos: { limit: 100 } } }),
		),
	)
).flatMap((r) => (r.entry ? [r.entry] : []));

// Photos that belong to a series show inside its folder card, not loose in the grid.
const inSeries = new Set(
	seriesList.flatMap((s) => s.references?.photos.entries.map((p) => p.id) ?? []),
);
const photos = photosResult.entries.filter((p) => !inSeries.has(p.id));
---

<Base>
	{
		photosResult.entries.length === 0 ? (
			<p class="empty">No photos yet. Run the importer or add one in the admin.</p>
		) : (
			<section class="gallery">
				{seriesList.map((s) => {
					const cover = s.references?.cover.entries[0] ?? s.references?.photos.entries[0];
					const count = s.references?.photos.entries.length ?? 0;
					return (
						<a href={`/series/${s.id}/`} class="card card--series" style={`--tilt:${tilt(s.id)}`}>
							{cover && <Image image={cover.data.image} alt={cover.data.title} sizes="(max-width: 680px) 100vw, 400px" />}
							<div class="card__label">Series · {count} photos</div>
							<div class="card__title">{s.data.title}</div>
						</a>
					);
				})}
				{photos.map((p) => (
					<a href={`/photos/${p.id}/`} class="card" style={`--tilt:${tilt(p.id)}`} {...p.edit}>
						<Image image={p.data.image} alt={p.data.title} sizes="(max-width: 680px) 100vw, 400px" />
						<div class="card__title">{p.data.title}</div>
						{formatDate(p.data.date_taken) && <div class="card__date">{formatDate(p.data.date_taken)}</div>}
					</a>
				))}
			</section>
		)
	}
</Base>
