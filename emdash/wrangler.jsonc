{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "memories",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "memories",
		},
	],
	// Public media for the site: metadata-free JPEG/WebP files only.
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "memories-media",
		},
		// Private: untouched originals, written by src/pages/api/originals.ts and
		// never served. The same bucket the Eleventy build restores originals from.
		{
			"binding": "ORIGINALS",
			"bucket_name": "photos",
		},
	],
	"triggers": {
		"crons": ["0 * * * *"],
	},
}
